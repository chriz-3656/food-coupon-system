SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Passwords should ideally be hashed, but for simplicity in a lightweight setup, we can use exact strings or bcrypt hashes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_admin_password

VOLUNTEER_PASSWORD=secure_volunteer_password

SESSION_SECRET=a_very_long_cryptographically_secure_random_string

COUPON_BASE_URL=http://localhost:3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
